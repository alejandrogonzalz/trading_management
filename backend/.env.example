# Binance API Credentials (Required)
# Create at: https://www.binance.com/en/my/settings/api-management
BINANCE_API_KEY=your_api_key_here
BINANCE_API_SECRET=your_api_secret_here
BINANCE_BASE_URL=https://api.binance.com

# Optional: Lead Trading Credentials
# Create inside Copy Trading > My Lead > API Management
BINANCE_COPY_TRADING_KEY=your_lead_trading_key_here
BINANCE_COPY_TRADING_SECRET=your_lead_trading_secret_here

# Optional: Database Configuration
# DATABASE_URL=sqlite:////app/data/trading.db

# Optional: LLM Configuration  
# OLLAMA_BASE_URL=http://ollama:11434
# OLLAMA_MODEL=qwen2.5:14b

# Optional: LangGraph Integration
# LANGGRAPH_URL=http://langgraph:2024