# LLM Provider: ollama, groq, deepseek, together, openai, google, bedrock, mock
LLM_PROVIDER=groq
LLM_MODEL=llama-3.3-70b-versatile

# Provider-specific API keys (set the one matching your LLM_PROVIDER)
GROQ_API_KEY=gsk_your_key_here
DEEPSEEK_API_KEY=sk-your_key_here
TOGETHER_API_KEY=your_key_here
OPENAI_API_KEY=sk-your_key_here

# Optional: override base URL for any OpenAI-compatible provider
# LLM_BASE_URL=https://api.groq.com/openai/v1
